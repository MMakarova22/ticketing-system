# Copy to .env and adjust as needed. .env is git-ignored. NEVER commit real credentials.
# Every variable is optional for `docker compose up --build`: docker-compose.yml has local defaults.

# --- PostgreSQL (local development only) -----------------------------------
POSTGRES_DB=ticketing_db
POSTGRES_USER=ticketing_user
POSTGRES_PASSWORD=ticketing_local_dev_password
# Host port for the database (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# Used by Prisma CLI and the API when running on the HOST (npm scripts).
# Inside Docker Compose the app builds its own URL with host "db".
# URL-encode special characters in the password.
DATABASE_URL="postgresql://ticketing_user:ticketing_local_dev_password@localhost:5432/ticketing_db?schema=public"

# --- Application --------------------------------------------------------------
# Host port for the app (container always listens on 3000)
APP_PORT=3000
# Public URL used in verification-email links
APP_BASE_URL=http://localhost:3000
# Login session lifetime in days
SESSION_TTL_DAYS=7
# Secure cookies work on http://localhost in Chrome, Edge and Firefox.
# Set to false only if you access the app over plain HTTP on a host other than localhost.
COOKIE_SECURE=true

# --- Proxy trust for the per-IP rate limits ------------------------------------
# Default: not set = disabled. X-Forwarded-For is ignored and the per-IP limits use the TCP peer address.
# Accepted: a hop count 1-10, or a comma-separated list of "loopback", "uniquelocal", IP addresses and CIDR
# ranges. "true" and /0 ranges are rejected at startup (they would let every client choose its own address).
# docker-compose.yml does NOT pass this variable to the app container, so setting it here only affects
# `npm run dev:api` on the host. The test stack sets it in docker-compose.test.yml (development machines only).
# TRUST_PROXY=

# --- SMTP (email verification) -----------------------------------------------
# Default: Mailpit (local inbox at http://localhost:8025). Nothing to configure.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticket Tracker <no-reply@ticketing.local>"

# To use a corporate SMTP relay instead, set (ask your administrator for host, port, TLS and credentials):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Mailpit host ports (bound to 127.0.0.1 only) -----------------------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
